# Normalise line endings to LF in the repository. Without this, a repo authored
# on Windows and cloned on macOS or Linux produces diffs where every line of
# every file appears changed, which makes review of the actual change impossible.
* text=auto eol=lf

# Certificates and keys are generated locally and gitignored, but if one is ever
# committed deliberately it must not be rewritten — a mangled PEM fails to parse.
*.pem -text

# Generated by npm; collapse it in review rather than reading 160k lines of it.
package-lock.json linguist-generated=true
