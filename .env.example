# ─────────────────────────────────────────────────────────────────────────────
# Trams — example configuration.
#
#   cp .env.example .env
#
# Every value below is a NON-SECRET placeholder safe to commit. Real secrets
# belong only in .env (gitignored) or your deployment's secret manager.
#
# When NODE_ENV=production, the config loader (packages/shared/src/config.ts)
# REFUSES to fall back to any development default and the process exits at
# boot. A missing secret should be a startup failure, not a 500 under load.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Service addresses ────────────────────────────────────────────────────────
# The gateway is the only component intended to be publicly reachable. The two
# backend services bind to loopback so they are unroutable from outside the host.
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0

USER_SERVICE_PORT=4001
USER_SERVICE_HOST=127.0.0.1
USER_SERVICE_URL=http://127.0.0.1:4001

NOTIFICATION_SERVICE_PORT=4002
NOTIFICATION_SERVICE_HOST=127.0.0.1
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4002

# ── Database ─────────────────────────────────────────────────────────────────
# DB_CLIENT=sqlite   -> DB_URL is a file path (zero install, default)
# DB_CLIENT=postgres -> DB_URL is a postgres:// connection string
# One Kysely query layer serves both; only the dialect differs.
DB_CLIENT=sqlite
USER_DB_URL=./data/user-service.db
NOTIFICATION_DB_URL=./data/notification-service.db

# ── JWT ──────────────────────────────────────────────────────────────────────
# RS256, not HS256: the gateway is given ONLY the public key, so it can verify
# tokens but cannot mint them. Generate the pair with `npm run keys`.
JWT_PRIVATE_KEY_PATH=./infra/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./infra/keys/jwt-public.pem
JWT_ISSUER=trams.user-service
JWT_AUDIENCE=trams.api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Gateway -> service authentication ────────────────────────────────────────
# Shared secret proving a request arrived via the gateway. Backend services
# reject anything without it, so a leaked internal port is not an open door.
# CHANGE THIS. Generate with: node -e "console.log(crypto.randomUUID())"
INTERNAL_TOKEN=dev-internal-token-change-me

# ── Edge hardening ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
BODY_LIMIT_BYTES=65536

# ── NATS ─────────────────────────────────────────────────────────────────────
# Per-service credentials. The broker enforces subject-level permissions
# (see infra/nats/nats.conf): user-service may ONLY publish user.*, and
# notification-service may ONLY subscribe to it. Neither can do the other's job.
NATS_URL=tls://127.0.0.1:4222

NATS_USER_SERVICE_USER=user-service
NATS_USER_SERVICE_PASS=dev-user-service-pass-change-me

NATS_NOTIFICATION_SERVICE_USER=notification-service
NATS_NOTIFICATION_SERVICE_PASS=dev-notification-service-pass-change-me

# ── NATS TLS (mutual) ────────────────────────────────────────────────────────
# Generate the CA and certificates with `npm run certs`.
# Set NATS_TLS_ENABLED=false only to run against a plain local broker.
NATS_TLS_ENABLED=true
NATS_CA_PATH=./infra/nats/certs/ca-cert.pem
NATS_CLIENT_CERT_PATH=./infra/nats/certs/client-cert.pem
NATS_CLIENT_KEY_PATH=./infra/nats/certs/client-key.pem

# ── Outbox publisher ─────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# ── Notification consumer ────────────────────────────────────────────────────
NOTIFICATION_CONSUMER_NAME=notification-worker
NOTIFICATION_MAX_DELIVER=5
NOTIFICATION_ACK_WAIT_MS=30000
NOTIFICATION_MAX_ACK_PENDING=100
NOTIFICATION_FETCH_BATCH=10

# ── Notification delivery channel ────────────────────────────────────────────
# console -> renders to structured logs (default; no external dependency)
# smtp    -> real mail via nodemailer; requires the SMTP_* values below
NOTIFICATION_CHANNEL=console
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@trams.local
